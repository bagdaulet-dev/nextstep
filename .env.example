# Reference values. Run python3 scripts/setup-env.py to generate unique local secrets.
APP_MODE=mysql
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-run-python3-scripts-setup-env-py-before-docker
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_COOKIES=false
DJANGO_SSL_REDIRECT=false
TRUST_PROXY=false
DEMO_ENABLED=true
API_DOCS_ENABLED=true
APP_TIME_ZONE=Asia/Almaty
APP_PORT=8002
MYSQL_DATABASE=nextstep
MYSQL_USER=nextstep
MYSQL_PASSWORD=change-me-generated-by-setup-env
MYSQL_ROOT_PASSWORD=change-me-generated-by-setup-env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
